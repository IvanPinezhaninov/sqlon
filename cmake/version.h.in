#ifndef SQLON_VERSION_H
#define SQLON_VERSION_H

/** @brief SQLon major version number. */
#define SQLON_VERSION_MAJOR @PROJECT_VERSION_MAJOR@

/** @brief SQLon minor version number. */
#define SQLON_VERSION_MINOR @PROJECT_VERSION_MINOR@

/** @brief SQLon patch version number. */
#define SQLON_VERSION_PATCH @PROJECT_VERSION_PATCH@

/** @brief SQLon version string. */
#define SQLON_VERSION_STRING "@PROJECT_VERSION@"

namespace sqlon {

/** @brief SQLon major version number. */
inline constexpr int version_major = SQLON_VERSION_MAJOR;

/** @brief SQLon minor version number. */
inline constexpr int version_minor = SQLON_VERSION_MINOR;

/** @brief SQLon patch version number. */
inline constexpr int version_patch = SQLON_VERSION_PATCH;

/** @brief SQLon version string. */
inline constexpr char version_string[] = SQLON_VERSION_STRING;

} // namespace sqlon

#endif // SQLON_VERSION_H
